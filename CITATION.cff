type: software
title: "FraudRAG: Evidence-Grounded Financial-Document Verification Research Prototype"
authors:
  - family-names: Sharma
    given-names: Akshay
repository-code: "https://github.com/akshaysharma1088/fraudrag"
url: "https://github.com/akshaysharma1088/fraudrag"
