# FraudRAG Environment Configuration
# Copy to .env and fill in your values

# ── LLM Configuration ──────────────────────────────────────
# Choose one provider:
LLM_PROVIDER=openai          # openai | anthropic
OPENAI_API_KEY=sk-...        # Required if using openai
ANTHROPIC_API_KEY=sk-ant-... # Required if using anthropic
LLM_MODEL=gpt-4o             # gpt-4o | claude-3-5-sonnet-20241022

# ── Neo4j Knowledge Graph ──────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fraudrag123

# ── PostgreSQL ─────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fraudrag:fraudrag@localhost:5432/fraudrag

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AWS (Optional – for S3 storage) ───────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ── App ─────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-me-to-a-secure-random-string-minimum-32-chars

# ── EAC Source Evidence Sandbox ────────────────────────────
# DISABLED by default. Only server-owned fictional issuer fixtures.
# Set true only in a locally controlled demo; never enables bank authentication.
EAC_DEMO_ENABLED=false

# ── Optional server-to-server EAC issuer onboarding ──────────
# KEEP DISABLED unless an approved bank/issuer has explicitly agreed to
# provide signed EAC_RECORD_V1 field receipts, consent and operator-pinned key.
# These values must come from your server secret manager, not the browser.
# Live acquisition has NO public API; consent/auth registry remains required.
EAC_PARTNER_ENABLED=false
EAC_PARTNER_ENDPOINT=
EAC_PARTNER_HOST=
EAC_PARTNER_ISSUER_ID=
EAC_PARTNER_KEY_ID=
EAC_PARTNER_PUBLIC_KEY_B64=
EAC_PARTNER_ACCESS_TOKEN=

# ── Plaid Statements verified-source PDF adapter ────────────
# Optional alternative to the custom signed-issuer record protocol.
# Plaid bank-provided PDFs are NOT issuer-signed evidence certificates.
# No Link/session creation, item refresh, or billed onboarding is triggered.
# Item access tokens must be held in a per-user secure consent vault, not here.
EAC_PLAID_ENABLED=false
EAC_PLAID_ENVIRONMENT=sandbox
EAC_PLAID_CLIENT_ID=
EAC_PLAID_SECRET=

# Optional sandbox/onboarded Plaid Link + encrypted local consent vault.
# Enables server-side service only; no browser endpoint, users or billable
# Link sessions are activated by this setting alone. Never put real creds
# or encryption master keys in committed files; inject via secrets manager.
# Server master key: 32 random bytes, standard base64, never rotate casually.
EAC_PLAID_LINK_ENABLED=false
EAC_PLAID_VAULT_PATH=
EAC_PLAID_VAULT_KEY_B64=
