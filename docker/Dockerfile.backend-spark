# FraudRAG Batch Pipeline — PySpark + Delta Lake
# Use this for the Medallion batch processing jobs, NOT the API service
FROM python:3.12.3-slim

WORKDIR /app

# Java 17 for PySpark
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jre-headless \
    tesseract-ocr \
    tesseract-ocr-eng \
    poppler-utils \
    libgl1 \
    libpq-dev \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="$JAVA_HOME/bin:$PATH"

# Base deps first
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Spark extras on top
COPY requirements-spark.txt .
RUN pip install --no-cache-dir -r requirements-spark.txt

COPY . ./backend/

ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "backend.pipelines.spark_runner"]
