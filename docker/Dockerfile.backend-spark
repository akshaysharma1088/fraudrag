# FraudRAG Batch Pipeline — PySpark + Delta Lake
# Build context: repo root (.)
FROM python:3.12.3-slim

WORKDIR /app

# Java 17 for PySpark + system deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jre-headless \
    tesseract-ocr \
    tesseract-ocr-eng \
    poppler-utils \
    libgl1 \
    libpq-dev \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
ENV PATH="$JAVA_HOME/bin:$PATH"

# ── Copy requirements from backend/ subdirectory ──
COPY backend/requirements.txt ./requirements.txt
COPY backend/requirements-spark.txt ./requirements-spark.txt

RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt \
 && pip install --no-cache-dir -r requirements-spark.txt

# ── Copy application code ──
COPY backend/ ./backend/

ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

CMD ["python", "-m", "backend.pipelines.spark_runner"]
