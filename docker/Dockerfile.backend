# FraudRAG API Backend
# Build context: repo root (.)  |  Dockerfile: docker/Dockerfile.backend
FROM python:3.12.3-slim

WORKDIR /app

# ── System dependencies ──────────────────────────────────────────────────────
# - tesseract: OCR for scanned PDFs
# - poppler-utils: PDF rendering (pdf2image)
# - libgl1: OpenCV dependency (via chromadb/onnx)
# - libgomp1: OpenMP — required by onnxruntime (chromadb dep)
# - libpq-dev + gcc: psycopg2-binary native build
# - libssl-dev: asyncpg TLS support
# - libffi-dev: cryptography package
# - curl: healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    poppler-utils \
    libgl1 \
    libgomp1 \
    libpq-dev \
    libssl-dev \
    libffi-dev \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ── Python dependencies ──────────────────────────────────────────────────────
# Copy from backend/ — build context is repo root
COPY backend/requirements.txt ./requirements.txt

RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt --timeout 120

# ── Application code ─────────────────────────────────────────────────────────
COPY backend/ ./backend/

ENV PYTHONPATH=/app
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health/live || exit 1

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2"]
